{
  "name": "personal-ai-os-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for the Personal AI OS - a unified chat interface with Gemini function-calling access to email, calendar, tasks, and finances.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "imapflow": "^1.0.161",
    "mailparser": "^3.7.1",
    "nodemailer": "^10.0.10",
    "plaid": "^27.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
