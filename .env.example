# Server
PORT=4000
APP_BASE_URL=http://localhost:4000

# Supabase (service role key is required server-side to read/write user_integrations
# across all users; the /chat endpoint still authenticates each request via the
# caller's Supabase JWT before touching any data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google OAuth (Gmail, Calendar, Tasks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Plaid (Sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
